# Multi-stage production Dockerfile for CHESS NEXUS Backend
FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Final production stage
FROM python:3.11-slim AS runner

WORKDIR /app

# Create non-root user for security hardening
RUN groupadd -g 1001 nexusgroup && \
    useradd -u 1001 -g nexusgroup -s /bin/bash -m nexususer

# Copy installed wheels and dependencies
COPY --from=builder /root/.local /home/nexususer/.local
ENV PATH=/home/nexususer/.local/bin:$PATH

# Copy backend application source
COPY --chown=nexususer:nexusgroup backend/app /app/app

USER nexususer

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--proxy-headers"]

